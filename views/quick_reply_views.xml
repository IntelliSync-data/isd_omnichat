<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_quick_reply_list" model="ir.ui.view">
        <field name="name">omnichat.quick.reply.list</field>
        <field name="model">omnichat.quick.reply</field>
        <field name="arch" type="xml">
            <list string="Quick Replies">
                <field name="shortcut"/>
                <field name="body"/>
                <field name="image_count" string="Images"/>
                <field name="user_id" widget="many2one_avatar_user" string="Owner (empty: shared)"/>
            </list>
        </field>
    </record>

    <record id="view_quick_reply_form" model="ir.ui.view">
        <field name="name">omnichat.quick.reply.form</field>
        <field name="model">omnichat.quick.reply</field>
        <field name="arch" type="xml">
            <form string="Quick Reply">
                <sheet>
                    <group>
                        <field name="shortcut" placeholder="e.g. xinchao"/>
                        <field name="body" placeholder="e.g. Dạ chào {name}! ..."/>
                        <field name="image_ids" widget="many2many_binary" string="Images (up to 6)"/>
                        <field name="user_id" groups="isd_omnichat.group_omnichat_manager"/>
                        <field name="active" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_quick_reply" model="ir.actions.act_window">
        <field name="name">Quick Replies</field>
        <field name="res_model">omnichat.quick.reply</field>
        <field name="path">omnichat-quick-replies</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No quick reply yet</p>
            <p>Type \shortcut in the chat box to send its text and up to 6 images.</p>
        </field>
    </record>
</odoo>
