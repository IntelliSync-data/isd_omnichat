<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_simple_modif_omnichat" model="ir.ui.view">
        <field name="name">res.users.preferences.omnichat</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form_simple_modif"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='tz']" position="after">
                <field name="omnichat_sound" readonly="0" groups="isd_omnichat.group_omnichat_agent"/>
                <field name="omnichat_desktop" readonly="0" groups="isd_omnichat.group_omnichat_agent"/>
            </xpath>
        </field>
    </record>
</odoo>
